# HubSpot private app token (Development > Legacy apps > your app > Auth > Show token). Starts with pat-.
# Scopes: crm.objects.contacts.read, crm.objects.contacts.write, crm.objects.owners.read, crm.schemas.contacts.read
HUBSPOT_TOKEN=pat-na1-your-private-app-token
# Optional: your Hub ID (account menu, top right). Adds record links to the Slack messages.
HUBSPOT_PORTAL_ID=
# Optional: https://app-eu1.hubspot.com for accounts hosted in the EU (default https://app.hubspot.com)
HUBSPOT_APP_URL=https://app.hubspot.com

# Safety first. The workflow changes nothing in HubSpot until DRY_RUN is "false".
DRY_RUN=true
# Exact duplicates merged automatically per run (0 to 50, 0 = never merge automatically). Close matches always need a person.
MAX_MERGES_PER_RUN=10
# Unowned contacts assigned per run (0 to 1000, 0 = routing off). HubSpot tells each owner about a new contact, so keep the
# first runs small.
MAX_ASSIGNMENTS_PER_RUN=100

# Run Now: send this value in the X-Run-Secret header. Make up a long random string.
RUN_NOW_SECRET=make-up-a-long-random-string
# The nightly run (2:30 in the n8n server's time zone) does nothing until this is true. Run Now always works.
SCHEDULE_ENABLED=false

# Approval links for close matches
# Signs every Approve and Skip link (HMAC SHA-256). At least 32 random characters. Changing it voids every open link.
APPROVAL_SECRET=make-up-another-long-random-string-of-32-or-more-characters
# The production URL of the approval webhook, as people will open it
APPROVAL_WEBHOOK_URL=https://your-n8n.example.com/webhook/hubspot-merge-approval
# How long a link works (1 to 336 hours) and how many close matches one run sends (1 to 40)
APPROVAL_LINK_HOURS=72
MAX_APPROVALS_PER_RUN=20

# Slack incoming webhook for the run summary, the approval requests, the decisions and the error alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Round robin. Owner emails or owner IDs, in the order they take turns. Empty = routing off.
ROUND_ROBIN_OWNERS=ava.lopez@yourcompany.example.com, ben.ortiz@yourcompany.example.com, cleo.park@yourcompany.example.com
# Owners from the list above who are away (on leave, out sick). They are skipped until removed from here.
AWAY_OWNERS=

# Field cleanup. Mapping tables are JSON objects: {"raw value": "allowed value"}. Keys ignore case, spaces and punctuation.
# Lead source: your own text or dropdown property (HubSpot's Original Source is calculated and cannot be changed). Empty = off.
LEAD_SOURCE_PROPERTY=lead_source
LEAD_SOURCE_MAP={"google": "Paid Search", "google ads": "Paid Search", "adwords": "Paid Search", "ppc": "Paid Search", "facebook": "Paid Social", "fb ads": "Paid Social", "linkedin": "Paid Social", "word of mouth": "Referral", "trade show": "Event", "webinar": "Event", "web form": "Website", "seo": "Organic Search"}
# Lifecycle stage: the text property where messy stage values sit (for example from an old CRM import). The mapped stage is
# written to HubSpot's Lifecycle stage, only forward. Values are HubSpot's internal stage values. Empty = off.
LIFECYCLE_TEXT_PROPERTY=legacy_lifecycle_stage
LIFECYCLE_MAP={"mql": "marketingqualifiedlead", "marketing qualified": "marketingqualifiedlead", "sql": "salesqualifiedlead", "prospect": "lead", "new lead": "lead", "client": "customer", "closed won": "customer", "opp": "opportunity"}

# Matching
# Domains where dots and a +tag in the part before the @ are ignored (Gmail rules)
EMAIL_DOT_PLUS_DOMAINS=gmail.com, googlemail.com
# Optional: free mail domains that never count as "the same company domain" (leave empty for the built in list)
FREE_EMAIL_DOMAINS=
# Country code added to phone numbers saved without one (1 = US and Canada)
DEFAULT_COUNTRY_CODE=1
# Time zone for dates in Slack and on the approval pages
REPORT_TIMEZONE=America/New_York

# Paging and retries (the defaults are fine)
HUBSPOT_PAGE_SIZE=100
MAX_CONTACT_PAGES=200
# First wait after a 429 or 5xx on a merge or update, in seconds. It doubles on every try (2, 4, 8, 16).
BACKOFF_SECONDS=2

# Self-hosted n8n must allow $env access in nodes
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
